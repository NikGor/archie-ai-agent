# ===========================================
# LLM Provider API Keys
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===========================================
# Google Services
# ===========================================
GOOGLE_API_KEY=your_google_api_key_here

# ===========================================
# OpenAI Vector Store (Document Search)
# ===========================================
OPENAI_VECTOR_STORE_ID=your_vector_store_id_here

# ===========================================
# Home Assistant MCP (Smarthome Control)
# ===========================================
# NOTE: use Home Assistant's LAN IP, not its .local mDNS hostname — Docker's
# bridge network DNS resolver cannot resolve mDNS names from inside a container.
HOMEASSISTANT_MCP_URL=http://192.168.1.100:8123/api/mcp
HOMEASSISTANT_MCP_TOKEN=your_homeassistant_long_lived_token_here

# ===========================================
# Android TV / IPTV
# ===========================================
TV_HOST=192.168.1.100
# Pair the TV once on the host and mount this directory into the container.
TV_CERT_FILE=~/.config/archie-tv-remote/cert.pem
TV_KEY_FILE=~/.config/archie-tv-remote/key.pem
TV_PLAYLIST_PATH=Sharavoz.Tv.ott (2) - футбол.m3u
SHARAVOZ_TOKEN=your_sharavoz_token_here

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Scheduler polling interval and maximum jobs claimed in one pass
CRON_POLL_INTERVAL=1.0
CRON_MAX_JOBS_PER_TICK=20

# ===========================================
# Default Configuration
# ===========================================
DEFAULT_PERSONA=business
DEFAULT_USER_NAME=Николай
DEFAULT_CONVERSATION_ID=default
